        spdx:standardLicenseHeaderHtml  "\n      <p><var class=\"optional-license-text\"> %%</var> <var class=\"replaceable-license-text\"><span title=\"can be replaced with the pattern .+\"> pig.dtx</span></var>\n        <br />\n<var class=\"optional-license-text\"> %%</var> Copyright <var class=\"replaceable-license-text\"><span title=\"can be replaced with the pattern .+\"> 2005 M. Y. Name</span></var>\n        <br />\n<var class=\"optional-license-text\"> %</var>\n        <br />\n<var class=\"optional-license-text\"> %</var> This work may be distributed and/or modified under the\n        <br />\n<var class=\"optional-license-text\"> %</var> conditions of the LaTeX Project Public License, either version 1.3\n        <br />\n<var class=\"optional-license-text\"> %</var> of this license or (at your option) any later version.\n        <br />\n<var class=\"optional-license-text\"> %</var> The latest version of this license is in\n        <br />\n<var class=\"optional-license-text\"> %</var> http://www.latex-project.org/lppl.txt\n        <br />\n<var class=\"optional-license-text\"> %</var> and version 1.3 or later is part of all distributions of LaTeX\n        <br />\n<var class=\"optional-license-text\"> %</var> version 2005/12/01 or later.\n        <br />\n<var class=\"optional-license-text\"> %</var>\n        <br />\n<var class=\"optional-license-text\"> %</var> This work has the LPPL maintenance status &quot;<var class=\"replaceable-license-text\"><span title=\"can be replaced with the pattern author-maintained|unmaintained|maintained\"> maintained</span></var>&quot;.\n        <br />\n<var class=\"optional-license-text\"> %</var>\n        <br />\n<var class=\"optional-license-text\"> %</var> The Current Maintainer of this work is <var class=\"replaceable-license-text\"><span title=\"can be replaced with the pattern .+\"> M. Y. Name</span></var>.\n        <br />\n<var class=\"optional-license-text\"> %</var>\n        <br />\n<var class=\"optional-license-text\"> %</var> This work consists of the <var class=\"replaceable-license-text\"><span title=\"can be replaced with the pattern .+\"> files pig.dtx and pig.ins\n        <br />\n% and the derived file pig.sty</span></var>.\n      </p>\n\n      ";
        spdx:standardLicenseHeaderTemplate
