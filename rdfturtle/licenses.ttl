<http://spdx.org/licenses/OFL-1.1-no-RFN>
        a                             spdx:ListedLicense;
        rdfs:comment                  "This license was released 26 February 2007. The identifier OFL-1.1-no-RFN should only be used when there is no Reserved Font Name. See OFL-1.1 and OFL-1.1-RFN for alternatives.";
        rdfs:seeAlso                  "http://scripts.sil.org/cms/scripts/page.php?item_id=OFL_web" , "https://opensource.org/license/OFL-1.1";
