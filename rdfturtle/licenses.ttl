                                        spdx:isLive         true;
                                        spdx:isValid        true;
                                        spdx:isWayBackLink  false;
                                        spdx:match          "false";
                                        spdx:order          "0"^^<http://www.w3.org/2001/XMLSchema#int>;
                                        spdx:timestamp      "2026-08-27T16:58:46Z";
