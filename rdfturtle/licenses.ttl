        a                              spdx:ListedLicenseException;
        rdfs:comment                   "This exception has been used with BSD-3-Clause.";
        rdfs:seeAlso                   "https://www.pcre.org/licence.txt";
        spdx:exceptionTextHtml         "\n\t<p>\n\tEXEMPTION FOR BINARY LIBRARY-LIKE PACKAGES<br />\n\n\t------------------------------------------\n\t</p>\n\n\t<p>\n\tThe second condition in the BSD licence (covering binary redistributions) does\n\tnot apply all the way down a chain of software. If binary package A includes\n\tPCRE2, it must respect the condition, but if package B is software that\n\tincludes package A, the condition is not imposed on package B unless it uses\n\tPCRE2 independently.\n\t</p>\n\n\t";
        spdx:isDeprecatedLicenseId     false;
        spdx:licenseExceptionTemplate  "EXEMPTION FOR BINARY LIBRARY-LIKE PACKAGES\n------------------------------------------\n\nThe second condition in the BSD licence (covering binary redistributions) does not apply all the way down a chain of software. If binary package A includes PCRE2, it must respect the condition, but if package B is software that includes package A, the condition is not imposed on package B unless it uses PCRE2 independently.\n\n";
        spdx:licenseExceptionText      "EXEMPTION FOR BINARY LIBRARY-LIKE PACKAGES\n------------------------------------------\n\nThe second condition in the BSD licence (covering binary redistributions) does\nnot apply all the way down a chain of software. If binary package A includes\nPCRE2, it must respect the condition, but if package B is software that\nincludes package A, the condition is not imposed on package B unless it uses\nPCRE2 independently.\n";
        spdx:name                      "PCRE2 exception" .

<http://spdx.org/licenses/LGPL-2.1+>
        a                               spdx:ListedLicense;
        rdfs:seeAlso                    "https://www.gnu.org/licenses/old-licenses/lgpl-2.1-standalone.html" , "https://opensource.org/license/LGPL-2.1";
