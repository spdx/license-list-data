    <spdx:licenseTextHtml>
         &lt;div class="optional-license-text"&gt; 
            &lt;p&gt;
               DO WHAT THE FUCK YOU WANT TO BUT IT&amp;apos;S
               NOT MY FAULT PUBLIC LICENSE&lt;br /&gt;

               Version 1, October 2013
            &lt;/p&gt;

         &lt;/div&gt;
