        &lt;var class="optional-license-text"&gt;&amp;lt;&lt;/var&gt;&lt;var class="replaceable-license-text"&gt;&lt;span title="can be replaced with the pattern yyyy|year"&gt; yyyy&lt;/span&gt;&lt;/var&gt;&lt;var class="optional-license-text"&gt;&amp;gt; &lt;/var&gt;
