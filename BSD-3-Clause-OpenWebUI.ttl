PREFIX spdx: <http://spdx.org/rdf/terms#>

<http://spdx.org/licenses/BSD-3-Clause-OpenWebUI>
        a                             spdx:ListedLicense;
        rdfs:comment                  "This license includes the BSD-3-Clause verbatim with additional clauses.";
        rdfs:seeAlso                  "https://github.com/open-webui/open-webui/blob/main/LICENSE";
        spdx:crossRef                 [ a                   spdx:CrossRef;
                                        spdx:isLive         true;
                                        spdx:isValid        true;
                                        spdx:isWayBackLink  false;
                                        spdx:match          "true";
                                        spdx:order          "0"^^<http://www.w3.org/2001/XMLSchema#int>;
                                        spdx:timestamp      "2026-09-03T16:00:51Z";
                                        spdx:url            "https://github.com/open-webui/open-webui/blob/main/LICENSE"
                                      ];
        spdx:isDeprecatedLicenseId    false;
        spdx:isOsiApproved            false;
